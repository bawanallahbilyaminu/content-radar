# Copy to .env and fill in. Never commit .env.

# Anthropic (LLM synthesis)
ANTHROPIC_API_KEY=

# Reddit script app (https://www.reddit.com/prefs/apps). App-only OAuth, no username.
# Leave empty to use the public subreddit RSS fallback.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=content-radar/0.1 (by u/your_username)

# GitHub token (optional, raises Search API rate limit)
GITHUB_TOKEN=

# Notion sink
NOTION_TOKEN=
NOTION_IDEAS_DB_ID=

# Stack Exchange API (optional; raises quota from 300 to 10,000 requests/day)
# Register at https://stackapps.com/apps/oauth/register
STACKEXCHANGE_KEY=

# Phase 5: YouTube Data API v3
YOUTUBE_API_KEY=
