# Copy to .env and fill in. Never commit .env.

# Anthropic (LLM synthesis)
ANTHROPIC_API_KEY=

# Reddit script app (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
