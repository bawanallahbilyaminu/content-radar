# GitHub token (optional, raises Search API rate limit)
GITHUB_TOKEN=

# Notion sink
NOTION_TOKEN=
NOTION_IDEAS_DB_ID=

# Phase 2: YouTube Data API v3
YOUTUBE_API_KEY=
